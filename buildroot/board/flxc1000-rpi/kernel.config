# FLXC1000 kernel config fragment for RPi4
# Applied on top of the arm64 defconfig

# RPi4 SoC (BCM2711 is part of the BCM2835 family in mainline)
CONFIG_ARCH_BCM2835=y

# GPIO / Pin control
CONFIG_PINCTRL_BCM2835=y
CONFIG_GPIO_BCM_VIRT=y

# I2C
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y

# SPI
CONFIG_SPI=y
CONFIG_SPI_BCM2835=y
CONFIG_SPI_BCM2835AUX=y

# UART (PL011 + mini-UART)
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_BCM2835AUX=y

# MMC / SD card
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y

# USB (base — board-specific drivers in kernel-rpiN.config)
CONFIG_USB=y

# Watchdog
CONFIG_BCM2835_WDT=y

# Thermal
CONFIG_BCM2835_THERMAL=y

# Networking
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

# Ethernet — board-specific drivers in kernel-rpiN.config

# Filesystem support
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y

# Initramfs / CPIO
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
